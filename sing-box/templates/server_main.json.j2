{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "strategy": "ipv4_only"
  },
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "http_clients": [
    {
      "tag": "http-1",
      "version": 2
    }
  ],
  "route": {
    "rules": [
      {"action": "sniff"},
      {"protocol": "bittorrent", "action": "reject"},
      {"ip_is_private": true, "outbound": "direct"},
      {"rule_set": "category-ads-all", "action": "reject"},
      {
        "rule_set": [
          "server",
          "youtube",
          "openai",
          "reddit",
          "category-ru",
          "category-ir",
          "category-porn",
          "geosite-cn",
          "geoip-cn",
          "geoip-ru",
          "geoip-ir",
{% for s in srs.user %}
          "{{ s.name }}"{{ "," if not loop.last else "" }}
{% endfor %}
        ],
        "outbound": "warp"
      }
    ],
    "default_http_client": "http-1"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/var/lib/{{ basename }}/cache/cache.db",
      "cache_id": "1"
    }
  }
}
