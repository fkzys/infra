http:
  middlewares:
    https_redirect:
      redirectscheme:
        scheme: "https"
        permanent: true
    secure-header:
      headers:
        referrerPolicy: "no-referrer"
        stsSeconds: 31536000
        forceSTSHeader: true
        stsPreload: true
        stsIncludeSubdomains: true
        browserXssFilter: true
        customRequestHeaders:
          X-Forwarded-Proto: "https"
    blacklist:
      ipAllowList:
        sourceRange:
{% for range in common.allowed_source_ranges %}
          - "{{ range }}"
{% endfor %}
        ipStrategy:
          excludedIPs:
            - "127.0.0.1/32"
{% for ip in common.cloudflare_ips %}
            - "{{ ip }}"
{% endfor %}
    blacklist-direct:
      ipAllowList:
        sourceRange:
{% for range in common.allowed_source_ranges %}
          - "{{ range }}"
{% endfor %}
