#!/bin/bash
set -euo pipefail
export HOME=/root
export RESTIC_PASSWORD="{{ backup.repo_password }}"

SNAP_CL="/opt/podman/opencloud-snap"
SNAP_SY="/opt/podman/synapse-snap"
SNAP_RL="/opt/podman/radicale-snap"

cleanup() {
  btrfs subvolume delete "$SNAP_CL" 2>/dev/null || true
  btrfs subvolume delete "$SNAP_SY" 2>/dev/null || true
  btrfs subvolume delete "$SNAP_RL" 2>/dev/null || true
}
trap cleanup EXIT

# btrfs snapshots
btrfs subvolume snapshot /opt/podman/opencloud "$SNAP_CL"
btrfs subvolume snapshot /opt/podman/synapse "$SNAP_SY"
btrfs subvolume snapshot /opt/podman/radicale "$SNAP_RL"

# clean opencloud snapshot
find "$SNAP_CL" -mindepth 1 \
  -path "$SNAP_CL/data/search/*" \
  -delete 2>/dev/null || true

{% for repo in backup.repositories %}
echo "=== {{ repo.name }} ==="

export RESTIC_REPOSITORY="s3:{{ repo.endpoint }}/{{ repo.bucket }}/{{ repo.prefix }}"
export AWS_ACCESS_KEY_ID="{{ repo.access_key }}"
export AWS_SECRET_ACCESS_KEY="{{ repo.secret_key }}"
export AWS_DEFAULT_REGION="{{ repo.region }}"

restic backup --host "{{ backup.hostname }}" --tag opencloud "$SNAP_CL"
restic backup --host "{{ backup.hostname }}" --tag synapse "$SNAP_SY"
restic backup --host "{{ backup.hostname }}" --tag radicale "$SNAP_RL"

{% endfor %}
echo "=== backup complete ==="
